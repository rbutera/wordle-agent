{
  "name": "wordle-agent",
  "version": "0.1.0",
  "description": "A Bun CLI that lets an AI agent play today's Wordle on nytimes.com via Bun.WebView, with built-in Hurdle candidate filtering.",
  "type": "module",
  "license": "MIT",
  "author": "rbutera",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rbutera/wordle-agent.git"
  },
  "homepage": "https://github.com/rbutera/wordle-agent#readme",
  "bugs": {
    "url": "https://github.com/rbutera/wordle-agent/issues"
  },
  "keywords": ["wordle", "bun", "webview", "cli", "ai-agent", "hurdle"],
  "bin": {
    "wordle-agent": "./bin/wordle-agent.ts"
  },
  "files": ["bin", "src", "data", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "start": "bun bin/wordle-agent.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "build": "bun build --compile --outfile dist/wordle-agent bin/wordle-agent.ts",
    "update-answers": "bun bin/wordle-agent.ts update-answers --bundled"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.0"
  }
}
